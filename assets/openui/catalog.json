{
  "version": 1,
  "renderer": "ledger-openui-v4",
  "layout_version": 1,
  "report_versions": [
    1
  ],
  "read_only": true,
  "features": [
    "svg-charts",
    "chart-list-toggle",
    "category-highlight",
    "date-inspection",
    "reduced-motion",
    "ai-openui-source",
    "nested-layouts",
    "generated-html",
    "generation-spec",
    "validated-live-preview",
    "income-charts",
    "transaction-type-filter",
    "income-expense-details"
  ],
  "components": {
    "Metric": {
      "refs": [
        "totals.income",
        "totals.expense",
        "totals.refund",
        "totals.net"
      ],
      "kinds": [
        "report"
      ]
    },
    "Breakdown": {
      "refs": [
        "by_category",
        "by_day",
        "by_income_merchant",
        "by_income_day"
      ],
      "kinds": [
        "report"
      ]
    },
    "Budget": {
      "refs": [
        "budgets"
      ],
      "kinds": [
        "report"
      ]
    },
    "Transactions": {
      "refs": [
        "transactions",
        "income_transactions",
        "expense_transactions"
      ],
      "kinds": [
        "report"
      ]
    },
    "ImportSummary": {
      "refs": [
        "import_summary"
      ],
      "kinds": [
        "import"
      ]
    },
    "ImportRows": {
      "refs": [
        "import_rows"
      ],
      "kinds": [
        "import"
      ]
    },
    "Issues": {
      "refs": [
        "import_issues"
      ],
      "kinds": [
        "import"
      ]
    }
  },
  "generation": {
    "modes": [
      "openui",
      "html"
    ],
    "validation_runtime": "Node.js >= 18 for AI OpenUI validation; no npm install or API key",
    "streaming": false,
    "live_preview": {
      "command": "report watch",
      "transport": "loopback-http-polling",
      "frozen_snapshot": true
    }
  }
}
